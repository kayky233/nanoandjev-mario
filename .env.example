TYPESAFE_API_KEY=

# Local OpenAI-compatible policy server.
LOCAL_POLICY_BASE_URL=http://127.0.0.1:11500/v1
LOCAL_POLICY_API_KEY=local
LOCAL_POLICY_MODE=chat
LOCAL_POLICY_TEMPERATURE=0.5

# Optional strong coach, called only after repeated scene failures.
MENTOR_BASE_URL=https://openav.icu/v1
MENTOR_API_KEY=
MENTOR_MODEL=gpt-5.6-sol

# Optional: search the web only when a repeated scene triggers the mentor.
# Keep this explicit; it may incur provider cost and adds latency only between episodes.
MENTOR_WEB_SEARCH_ENABLED=false
# BAIDU_AI_SEARCH_API_KEY=...
# BAIDU_AI_SEARCH_MODEL=ernie-4.5-turbo-32k
# BAIDU_AI_SEARCH_SOURCE=baidu_search_v2
# MENTOR_SEARCH_TIMEOUT=18
